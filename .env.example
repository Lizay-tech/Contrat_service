# ---------------------------------------------------------------------------
# contrat-service (EDUCA.TECH) - Example environment
# Copy to .env and adjust for your environment.
# ---------------------------------------------------------------------------

# --- Service ---
NODE_ENV=development
PORT=8091
SERVICE_NAME=contrat-service
LOG_LEVEL=info
# Public base domain (behind Kong)
PUBLIC_DOMAIN=contrat.educasoft.tech

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educa_contrat_service
DB_USER=educa
DB_PASSWORD=educa
DB_POOL_MAX=10
DB_POOL_MIN=0
# The application connects as a NON-superuser role so RLS is enforced.
# (Superusers and table owners bypass RLS unless FORCE ROW LEVEL SECURITY is set.)

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# TTL (seconds) for cached active-year lookups
ANNEE_SCOLAIRE_CACHE_TTL=3600

# --- RabbitMQ ---
RABBITMQ_URL=amqp://educa:educa@localhost:5672
RABBITMQ_EXCHANGE=educa.contracts
RABBITMQ_EXCHANGE_TYPE=topic

# --- JWT (issued by manage-account:8081) ---
JWT_SECRET=educa_access_secret_2026
JWT_ALGORITHM=HS256

# --- EDUCA system tenant (owner of ETABLISSEMENT / global contracts) ---
# Fixed UUID identifying the EDUCA/Lizay system tenant.
EDUCA_SYSTEM_TENANT_ID=00000000-0000-0000-0000-0000000ed0ca
# Roles allowed to create ETABLISSEMENT-scoped contracts (comma separated)
EDUCA_ADMIN_ROLES=SUPER_ADMIN,EDUCA_ADMIN

# --- Inter-service HTTP (base URLs behind Kong or direct) ---
ANNEE_SCOLAIRE_SERVICE_URL=http://localhost:8082
MANAGE_ACCOUNT_SERVICE_URL=http://localhost:8081
SIGNATURE_SERVICE_URL=http://localhost:8093

# --- File storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25
