# ---------------------------------------------------------------------------
# contrat-service (EDUCA.TECH) - Phase 1 - Exemple de configuration
# Copier vers .env et adapter. NE JAMAIS committer le vrai .env.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=8091
SERVICE_NAME=contrat-service
API_PREFIX=/api/v1
LOG_LEVEL=info

# Base de donnees PostgreSQL (base dediee)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educa_contrat_service
DB_USER=educa
DB_PASSWORD=educa_secret
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# Redis (contexte, cache permissions / annee scolaire)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=contrat:

# RabbitMQ (bus d'evenements de cycle de vie)
RABBITMQ_URL=amqp://educa:educa@localhost:5672
RABBITMQ_EXCHANGE=educa.contracts

# JWT (secret PARTAGE emis par manage-account) - claims camelCase
JWT_SECRET=educa_access_secret_2026

# Tenant systeme EDUCA (proprietaire des contrats d'etablissement / globaux)
EDUCA_SYSTEM_TENANT_ID=00000000-0000-0000-0000-000000000001

# Roles autorises a creer un contrat d'etablissement (scope ETABLISSEMENT)
EDUCA_ADMIN_ROLES=SUPER_ADMIN,EDUCA_ADMIN

# Roles autorises a creer/publier des modeles de contrat (templates)
TEMPLATE_MANAGER_ROLES=SCHOOL_ADMIN,RESP_RH,EDUCA_ADMIN,SUPER_ADMIN

# Stockage documentaire (disque local en Phase 1)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# Services inter-microservices (clients HTTP)
ACADEMIC_YEAR_SERVICE_URL=http://localhost:8082
# En dev local: http://localhost:8093
# En Docker (reseau partage educa-net): http://educa-dev-signature:8093
SIGNATURE_SERVICE_URL=http://localhost:8093
COMMUNICATION_SERVICE_URL=http://localhost:8087
