{
  "name": "contrat-service",
  "version": "1.0.0",
  "description": "EDUCA.TECH Contract Lifecycle Management Service (CLM) - Phase 1",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node src/infrastructure/database/migrate.ts up",
    "migrate:undo": "ts-node src/infrastructure/database/migrate.ts down",
    "migrate:prod": "node dist/infrastructure/database/migrate.js up",
    "seed": "ts-node src/infrastructure/database/seed.ts up",
    "seed:undo": "ts-node src/infrastructure/database/seed.ts down",
    "seed:prod": "node dist/infrastructure/database/seed.js up",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "educa",
    "contract",
    "clm",
    "microservice"
  ],
  "author": "EDUCA.TECH",
  "license": "UNLICENSED",
  "dependencies": {
    "amqplib": "^0.10.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "sequelize": "^6.37.3",
    "umzug": "^3.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
